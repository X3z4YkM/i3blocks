
#!/bin/bash
# Alsamixer
vol=$(awk -F"[][]" '/Left:/ { print $2 }' <(amixer sget IEC958 | grep "\[on\]") | sed 's/%//')

# Check if the volume is not empty and greater than 0
if [ -n "$vol" ] && [ "$vol" -gt 0 ]; then
  echo "<span foreground='#81A1C1' size='large'></span> <span size='small' rise='2pt'>$vol%</span>" 
else
  echo "<span foreground='#bf616a' size='large'>ﱝ</span>"
fi
