#!/usr/bin/env bash

decimals=${DECIMALS:-0}
label=${LABEL:-""}

read -ra c1 < <(grep '^cpu ' /proc/stat)
sleep 1
read -ra c2 < <(grep '^cpu ' /proc/stat)

total1=0; for i in "${c1[@]:1}"; do ((total1+=i)); done
total2=0; for i in "${c2[@]:1}"; do ((total2+=i)); done

idle1=${c1[4]}
idle2=${c2[4]}

diff_total=$((total2 - total1))
diff_idle=$((idle2 - idle1))

cpu_usage=$(awk "BEGIN {printf \"%.${decimals}f\", ($diff_total - $diff_idle) * 100 / $diff_total}")

echo "${label}<span size='small' rise='2pt'>${cpu_usage}%</span>"
